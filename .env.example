# VolumeCalcKit Environment Variables Example
# Copy to .env.local for Next.js development

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://volumecalckit.com

# Cloudflare Turnstile Public Site Key (Browser)
# Use Cloudflare's always-passes test key in development if desired: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile Secret Key (Cloudflare Pages Function Server-side)
# Test secret key that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Resend API Key for transactional contact form emails
RESEND_API_KEY=

# Destination email where contact submissions will be received
CONTACT_TO_EMAIL=your-real-inbox@example.com

# Verified sender address configured in your Resend account
CONTACT_FROM_EMAIL=VolumeCalcKit <contact@volumecalckit.com>
